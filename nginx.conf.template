# Wird vom offiziellen nginx-Image per envsubst zu /etc/nginx/conf.d/default.conf
# verarbeitet. Nur Umgebungsvariablen (z. B. ${IMMICH_URL}) werden ersetzt;
# nginx-Variablen wie $uri/$host bleiben unangetastet.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: clientseitige Routen auf index.html zurückfallen lassen.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Immich-API gleich-origin durchreichen → kein CORS im Browser nötig.
    # /api/... wird unverändert an ${IMMICH_URL}/api/... weitergereicht.
    location /api/ {
        proxy_pass ${IMMICH_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
    }
}
