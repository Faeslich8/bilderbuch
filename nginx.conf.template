# Liefert die statische SPA aus UND proxyt /api/ same-origin zum Immich-Server
# (IMMICH_URL, z. B. http://immich_server:2283 bei Docker-Compose/Portainer im
# selben Netzwerk). Kein CORS auf Immich nötig, da der Browser nur mit dieser
# einen Origin spricht. Nur Umgebungsvariablen (${IMMICH_URL}) werden per
# envsubst ersetzt; nginx-Variablen wie $uri/$host bleiben unangetastet.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # WebDAV-PUTs werden erst in eine Temp-Datei gepuffert und dann per rename()
    # an ihren Zielpfad verschoben. Temp und Ziel müssen auf DEMSELBEN Dateisystem
    # liegen (sonst "cross-device link"). Beide auf dem /data-Volume.
    client_body_temp_path /data/tmp;

    # Zentraler Bearbeitungs-Speicher (geräteübergreifend): schlichter Datei-Store
    # per WebDAV auf ein persistentes Volume. GET liest, PUT schreibt, DELETE löscht.
    # /store/<name>.json  ->  /data/store/<name>.json
    location /store/ {
        root /data;
        dav_methods PUT DELETE;
        create_full_put_path on;
        dav_access user:rw group:rw all:r;
        client_max_body_size 25m;
        autoindex off;
        limit_except GET PUT DELETE { deny all; }
    }

    # Gebaute Assets tragen einen Inhalts-Hash im Dateinamen -> dauerhaft cachebar.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html und die Laufzeit-Konfig NIEMALS cachen: sonst zeigt der Browser
    # nach einem Update weiter auf das alte (gehashte) JS-Bundle und neue
    # Funktionen "fehlen", bis der Nutzer hart neu lädt.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
        try_files $uri =404;
    }
    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
        try_files $uri =404;
    }

    # SPA: clientseitige Routen auf index.html zurückfallen lassen.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Immich-API gleich-origin durchreichen -> kein CORS im Browser nötig.
    # /api/... wird unverändert an ${IMMICH_URL}/api/... weitergereicht.
    location /api/ {
        proxy_pass ${IMMICH_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
    }
}
