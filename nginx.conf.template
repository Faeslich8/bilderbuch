# Liefert nur die statische SPA aus. KEIN API-Proxy: der Browser verbindet sich
# direkt mit dem Immich-Server (Server-URL wird in der App eingegeben). Dafür muss
# Immich CORS für die Origin dieser App erlauben — siehe README.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
